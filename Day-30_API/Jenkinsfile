pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                // Force full repo checkout (avoids Jenkins SCM issues)
                git branch: 'master',
                    url: 'https://github.com/UdayKohai/Capegemini_Automation_testing_Assignmnents_Uday_Mathur_6739672.git'
            }
        }

        stage('Debug Workspace') {
            steps {
                echo "=== ROOT DIRECTORY ==="
                bat 'dir'

                echo "=== INSIDE Day-30_API ==="
                dir('Day-30_API') {
                    bat 'dir'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Day-30_API') {
                    bat 'npm install'
                    bat 'npx playwright install'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('Day-30_API') {
                    script {
                        def status = bat(script: 'npx playwright test', returnStatus: true)
                        if (status != 0) {
                            echo "Tests failed, but continuing to generate reports..."
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Generating HTML reports...'

            publishHTML(target: [
                reportDir: 'Day-30_API/playwright-report',
                reportFiles: 'index.html',
                reportName: 'Playwright HTML Report',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: true
            ])
        }
    }
}